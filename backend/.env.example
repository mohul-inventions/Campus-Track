PORT=5000
NODE_ENV=development

# MySQL 8.0 Database Connection
# Local Development:
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=campustrack_db

# For Cloud MySQL (e.g. Railway, Aiven, TiDB):
# DB_HOST=your-cloud-db-host
# DB_PORT=3306
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_NAME=campustrack_db

# Security & JWT Secret
JWT_SECRET=campustrack_jwt_secret_super_secure_key_2026_capstone
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*
